.DS_Store
Thumbs.db
desktop.ini

# Logs and local databases
*.log
*.sqlite
*.sqlite3

# Data generated locally; directory placeholders and samples stay tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep

# Trained models and experiment outputs
models/*
!models/.gitkeep
artifacts/
reports/generated/

# Locally generated research score evidence; never commit source-derived records.
frontend/evidence-data.json
# CARE replay data derived from CC BY-SA 4.0 source; regenerate with scripts/build_care_app_data.py.
frontend/care-data/

# Private mentor reports: shared only between the student and supervisor, never committed.
docs/reports/

# Hosted runtime package (scripts/package_runtime.py); kept in private Blob Storage.
runtime.zip
